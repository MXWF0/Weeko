        <item name="android:textStyle">normal</item>
        <item name="android:textColor">@color/weeko_edu_bottom_foreground</item>
        <item name="android:minHeight">48dp</item>
        <item name="chipMinHeight">32sp</item>
        <item name="chipBackgroundColor">@color/weeko_edu_bottom_surface</item>
